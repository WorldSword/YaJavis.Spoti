# Use the same cross compiler for Opus, ring and Lua.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{JARVIS_CMAKE_CC})
  set(CMAKE_SYSTEM_PROCESSOR "$ENV{JARVIS_CMAKE_CPU}")
  set(JARVIS_CC "$ENV{JARVIS_CMAKE_CC}")
  set(JARVIS_AR "$ENV{JARVIS_CMAKE_AR}")
else()
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
  set(JARVIS_CC "$ENV{CC_aarch64_unknown_linux_musl}")
  set(JARVIS_AR "$ENV{AR_aarch64_unknown_linux_musl}")
endif()
set(CMAKE_C_COMPILER "${JARVIS_CC}")
set(CMAKE_CXX_COMPILER "${JARVIS_CC}")
set(CMAKE_ASM_COMPILER "${JARVIS_CC}")
set(CMAKE_AR "${JARVIS_AR}")
set(CMAKE_RANLIB "" CACHE FILEPATH "Zig ar writes the archive index")
